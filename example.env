# ============================================
# CogniPath Environment Variables
# ============================================
# Copy this file to .env and fill in your keys
# cp example.env .env
# ============================================

# MongoDB Connection
MONGO_DB_URI=mongodb://localhost:27017
MONGO_DB_NAME=cognipath

# Google Gemini API
# Get your key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3
# Enable at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your_youtube_api_key_here

# App Security
SECRET_KEY=change_this_to_a_random_32_char_string_minimum

# CORS (frontend dev server)
CORS_ORIGINS=http://localhost:5173

# Tavily Web Search
# Get your key: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Firecrawl Web Scraper
# Get your key: https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ML Thresholds
DECAY_THRESHOLD=0.70
DECAY_ALERT_WINDOW_DAYS=3
